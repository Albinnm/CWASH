# Optional runtime settings. Node 24 is required. Never commit real credentials.
PORT=3000
HOST=127.0.0.1
CWASH_DATA_DIR=./data
# Set to true when serving behind HTTPS; a TLS reverse proxy is required for public use.
COOKIE_SECURE=false
# Hosting only: use an exact HTTPS origin and a verified reverse-proxy hop count.
# CWASH_PUBLIC_ORIGIN=https://your-service.onrender.com
# CWASH_TRUST_PROXY_HOPS=1
# Set initial admin credentials in private hosting settings, never commit them.

# Stripe remains disabled until configured; see docs/STRIPE-SETUP.md.
# Keep all credentials server-side. Start with a Stripe sandbox and a separate test database.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MEMBERSHIP_PRICE_ID=
CWASH_ENABLE_LIVE_PAYMENTS=false
