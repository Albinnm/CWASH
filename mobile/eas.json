{
  "cli": { "version": ">= 27.2.0", "appVersionSource": "remote" },
  "build": {
    "preview": { "distribution": "internal", "android": { "buildType": "apk" } },
    "production": { "autoIncrement": true, "environment": "production" },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "ios": { "simulator": false }
    }
  },
  "submit": { "production": {}, "testflight": {} }
}
